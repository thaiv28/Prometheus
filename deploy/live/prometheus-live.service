[Unit]
Description=Prometheus live publisher (Riot feed, Kalshi and FORGE to the live pages)
Wants=network-online.target
After=network-online.target prometheus-live-refresh.service

[Service]
User=prometheus
EnvironmentFile=/etc/prometheus-live.env
WorkingDirectory=/srv/prometheus-live/app
ExecStart=/bin/bash -c 'exec /home/prometheus/.local/bin/uv run --frozen --no-dev python -m prometheus.live.service ${LIVE_MAP_SIGNAL_ARGS:-} --fetch --idle-exit 90 --s3 "s3://${SITE_BUCKET}/current/live"'
# Restart crashes and idle updates (5); refused access (3) stops, inactivity (4) powers off.
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=3 4
ExecStopPost=/bin/bash /srv/prometheus-live/app/deploy/live/backup.sh
ExecStopPost=+/bin/bash -c 'if [ "$EXIT_STATUS" = 4 ]; then systemctl poweroff; fi'

NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
