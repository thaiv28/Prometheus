{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/srv/prometheus-live/app/data/live/**/trading/decisions.jsonl",
            "log_group_name": "/thaiv/prometheus/live/decisions",
            "log_stream_name": "{instance_id}",
            "publish_multi_logs": true,
            "timezone": "UTC"
          },
          {
            "file_path": "/srv/prometheus-live/app/data/live/worker.jsonl",
            "log_group_name": "/thaiv/prometheus/live/worker",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
