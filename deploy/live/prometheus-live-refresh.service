[Unit]
Description=Refresh the Prometheus live worker (code, dependencies, database, team catalog)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=prometheus
EnvironmentFile=/etc/prometheus-live.env
ExecStart=/bin/bash /srv/prometheus-live/app/deploy/live/refresh.sh
# Root, as systemd's "+": restart the service only when the refresh changed something.
ExecStartPost=+/bin/bash -c 'if [ -e /srv/prometheus-live/restart ]; then rm /srv/prometheus-live/restart; systemctl try-restart prometheus-live.service; fi'
TimeoutStartSec=1800
