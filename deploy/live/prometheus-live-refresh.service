[Unit]
Description=Refresh the Prometheus live worker (code, dependencies, database, team catalog)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=prometheus
EnvironmentFile=/etc/prometheus-live.env
ExecStart=/bin/bash /srv/prometheus-live/app/deploy/live/refresh.sh
# Root removes an idle worker's update flag; active workers consume it between live games.
ExecStartPost=+/bin/bash -c 'if [ -e /srv/prometheus-live/restart ] && ! systemctl is-active --quiet prometheus-live.service; then rm /srv/prometheus-live/restart; fi'
TimeoutStartSec=1800
