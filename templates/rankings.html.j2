{% extends 'base.html.j2' %}
{% block title %}{{ metric.name }} rankings · Prometheus{% endblock %}
{% block description %}{{ metric.full_name }}: {{ metric.description }}{% endblock %}
{% block canonical_path %}{{ metric.key }}.html{% endblock %}
{% set rating = config.kind == 'rating' %}
{% set noun = 'teams' if rating else 'team-seasons' %}
{% set year_label = 'season' if rating else 'years' %}
{% set value_word = 'rating' if rating else 'score' %}
{% block content %}
  <div class="spread">
    <div class="spread-main">
      <header class="section-head">
        <h1>{{ metric.name }} <span class="full-name">{{ metric.full_name }}</span></h1>
        <p class="lede">{{ metric.description }}<a class="note-ref" href="#note-{{ metric.lede_note }}" aria-label="Note {{ metric.lede_note }}">{{ metric.lede_note }}</a></p>
      </header>

      {% if metric.matchup %}
      <figure class="matchup" aria-labelledby="matchup-cap">
        <figcaption id="matchup-cap" class="figure-caption"><span class="matchup-title">Head to head.</span> Chance of winning one game today.<a class="note-ref" href="#note-2" aria-label="Note 2">2</a></figcaption>
        <p class="matchup-line">
          <label class="visually-hidden" for="matchup-a">First team</label>
          <select id="matchup-a" class="matchup-team">
            {% for r in rows if r.now %}<option value="{{ r.teamname }}"{% if loop.index == 1 %} selected{% endif %}>{{ r.teamname }}</option>{% endfor %}
          </select>
          <span class="matchup-verb">beats</span>
          <label class="visually-hidden" for="matchup-b">Second team</label>
          <select id="matchup-b" class="matchup-team">
            {% for r in rows if r.now %}<option value="{{ r.teamname }}"{% if loop.index == 2 %} selected{% endif %}>{{ r.teamname }}</option>{% endfor %}
          </select>
          <output class="matchup-result" id="matchup-result" for="matchup-a matchup-b" aria-live="polite"></output>
        </p>
        <div class="matchup-bar" aria-hidden="true"><span class="matchup-bar-a"></span></div>
      </figure>
      {% endif %}

      <figure class="dist" aria-labelledby="dist-cap">
        <figcaption id="dist-cap" class="figure-caption">How {{ value_word }}s are spread for the {{ noun }} below. <span class="dist-hint">Hover over a row to mark it on the chart.</span></figcaption>
        <div class="dist-plot" id="dist" role="img" aria-label="Distribution of {{ metric.name }} values in the current view"></div>
      </figure>

      <div class="filter-line" role="group" aria-label="Filters">
        <span class="filter-lead">Filter</span>
        {% if filters.years | length > 1 %}
        <details class="picker" data-filter="years">
          <summary><span class="picker-label">{{ year_label }}</span> <span class="picker-value" data-all="{{ 'Now' if rating else 'All' }}">{{ 'Now' if rating else 'All' }}</span></summary>
          <fieldset class="picker-panel">
            <legend class="picker-legend">{{ 'Season’s end' if rating else 'Years' }}</legend>
            {% if rating %}
            <button type="button" class="picker-shortcut" data-filter="years" data-select="">Current ratings</button>
            {% endif %}
            <div class="picker-options picker-options--years">
              {% for y in filters.years | reverse %}
              <label><input type="checkbox" value="{{ y }}" /> {{ y }}</label>
              {% endfor %}
            </div>
          </fieldset>
        </details>
        {% endif %}
        <details class="picker" data-filter="leagues">
          <summary><span class="picker-label">leagues</span> <span class="picker-value" data-all="All">All</span></summary>
          <fieldset class="picker-panel picker-panel--leagues">
            <legend class="picker-legend">Leagues</legend>
            {% if filters.leagues | length > 4 %}
            <button type="button" class="picker-shortcut" data-select="{{ major_leagues | join(',') }}">Major leagues only</button>
            {% endif %}
            <div class="picker-options">
              {% for l in filters.leagues %}
              <label data-league="{{ l }}"><input type="checkbox" value="{{ l }}" /> <span class="league-mark" aria-hidden="true"></span>{{ l }}</label>
              {% endfor %}
            </div>
          </fieldset>
        </details>
        <button type="button" class="clear-filters" hidden>Clear filters</button>
      </div>

      <figure class="register-figure register-figure--main" aria-labelledby="table-cap">
        <figcaption id="table-cap" class="table-caption"><span id="table-desc">{{ metric.name }}, all {{ noun }}{{ ' playing now' if rating }}</span>, ranked by {{ value_word }}.<a class="note-ref" href="#note-dagger" aria-label="Caveat">†</a> <span class="count" aria-live="polite"></span></figcaption>
        <div class="table-scroll">
          <table class="register register--sortable">
            <thead>
              <tr>
                {% for c in config.columns %}
                {% if c.bar %}<th scope="col" class="bar-col" aria-hidden="true"></th>{% endif %}
                <th scope="col" data-key="{{ c.key }}" data-type="{{ c.type }}" class="{{ 'num' if c.type in ['number', 'rank'] }}{% if c.wideOnly %} wide-only{% elif c.phoneHide %} phone-hide{% endif %}{% if c.type == 'rank' %} rank{% endif %}" aria-sort="none"{% if c.hint %} title="{{ c.hint }}"{% endif %}>
                  <button type="button">{{ 'Rk' if c.type == 'rank' else c.label }}{% if c.note %}<sup class="th-note" aria-hidden="true">{{ c.note }}</sup>{% endif %}<span class="sort-mark" aria-hidden="true"></span></button>
                </th>
                {% endfor %}
              </tr>
            </thead>
            <tbody id="rows">
              <tr><td colspan="{{ config.columns | length + 1 }}" class="empty">Loading…</td></tr>
            </tbody>
          </table>
        </div>
        <noscript><p class="empty">Turn on JavaScript to see and sort this table.</p></noscript>
      </figure>
    </div>

    <aside class="margin notes" id="about" aria-labelledby="about-heading">
      <h2 id="about-heading" class="margin-head">How to read {{ metric.name }}</h2>
      <ol class="notes-list">
        {% for line in metric.how_to_read %}
        <li id="note-{{ loop.index }}"><span class="note-mark" aria-hidden="true">{{ loop.index }}</span>{{ line }}</li>
        {% endfor %}
        <li id="note-dagger" class="caveat"><span class="note-mark" aria-hidden="true">†</span><span class="visually-hidden">Caveat: </span>{{ metric.caveats }}</li>
      </ol>
    </aside>
  </div>

  <script type="application/json" id="rows-data">{{ rows | tojson }}</script>
  <script type="application/json" id="page-config">{{ config | tojson }}</script>
{% endblock %}
{% block scripts %}
  <script src="js/rankings.js" defer></script>
  {% if metric.matchup %}<script src="js/forecast.js" defer></script>{% endif %}
{% endblock %}
