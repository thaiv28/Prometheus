{#- Small printed marks shared across pages. -#}
{% macro league(code, show_code=True) -%}
<span class="league" data-league="{{ code }}"><span class="league-mark" aria-hidden="true"></span>{% if show_code %}{{ code }}{% else %}<span class="visually-hidden">{{ code }}</span>{% endif %}</span>
{%- endmacro %}

{% macro signed(v, digits=2) -%}
{%- if v is none -%}—{%- elif v > 0 -%}+{{ ('%.' ~ digits ~ 'f') | format(v) }}{%- elif v < 0 -%}−{{ ('%.' ~ digits ~ 'f') | format(-v) }}{%- else -%}{{ ('%.' ~ digits ~ 'f') | format(v) }}{%- endif -%}
{%- endmacro %}

{% macro ordinal(n) -%}
{{ n }}{% if n % 100 in [11, 12, 13] %}th{% elif n % 10 == 1 %}st{% elif n % 10 == 2 %}nd{% elif n % 10 == 3 %}rd{% else %}th{% endif %}
{%- endmacro %}

{#- Head-to-head team options: grouped by league (major leagues first, in their
    usual order), alphabetical within each; `pick` 0 or 1 preselects the top or
    second-rated team. `rows` are FORGE rows; only "now" rows are listed. -#}
{% macro matchup_options(rows, pick) -%}
{%- set now = rows | selectattr('now') | list -%}
{%- set chosen = (now | sort(attribute='forge', reverse=True) | list)[pick].teamname -%}
{%- set present = now | map(attribute='league') | unique | list -%}
{%- for lg in major_leagues + (present | reject('in', major_leagues) | sort | list) if lg in present %}
<optgroup label="{{ lg }}">
  {%- for r in now | selectattr('league', 'equalto', lg) | sort(attribute='teamname') %}<option value="{{ r.teamname }}"{% if r.teamname == chosen %} selected{% endif %}>{{ r.teamname }}</option>{% endfor -%}
</optgroup>
{%- endfor %}
{%- endmacro %}

{#- The fixture register: matches grouped by day, each team's series chance either
    side of a duel bar. `days` from `predictions_view`; `results` adds the score
    and the call; `root` prefixes team links; `compact` (home) drops the method
    column. A match with a Kalshi price gets a caret on its duel bar at the
    market's chance and a Kalshi column: the current price in upcoming registers, the closing line (last price before the start) in results. Rows carry data-start (UTC) so predictions.js can set local times and
    regroup the days, and data-league / data-teams for its filters. -#}
{% macro fixtures(days, results=False, root='', compact=False, id='') -%}
{%- set by = not compact and not results -%}
<table class="register register--fixtures{% if results %} register--results{% endif %}"{% if id %} id="{{ id }}"{% endif %}>
  <thead>
    <tr>
      <th scope="col" class="fx-time">{{ 'Time' }}<span class="fx-tz"> (UTC)</span></th>
      <th scope="col" class="wide-only fx-lg">League</th>
      <th scope="col" class="fx-team fx-team--1"><span class="visually-hidden">First team</span></th>
      <th scope="colgroup" colspan="3" class="fx-series-head" title="Each team's chance of winning the series, in 100">Series chance{% if not compact %}<sup class="th-note" aria-hidden="true">1</sup>{% endif %}</th>
      <th scope="col" class="fx-team fx-team--2"><span class="visually-hidden">Second team</span></th>
      {% if not results %}<th scope="col" class="phone-hide">Bo</th>{% endif %}
      {% if not results %}<th scope="col" class="num phone-hide fx-opt" title="Chance of winning one game, first team–second team">Game{% if not compact %}<sup class="th-note" aria-hidden="true">1</sup>{% endif %}</th>{% endif %}
      {% if not results %}<th scope="col" class="num phone-hide" title="Kalshi’s prediction market: each team’s chance of taking the series, as of the last update">Kalshi{% if not compact %}<sup class="th-note" aria-hidden="true">5</sup>{% endif %}</th>{% endif %}
      {% if by %}<th scope="col" class="wide-only fx-opt">By{% if not compact %}<sup class="th-note" aria-hidden="true">2</sup>{% endif %}</th>{% endif %}
      {% if results %}<th scope="col" class="num phone-hide fx-close" title="Kalshi’s closing line: its last price before the start, each team’s chance of taking the series">Close{% if not compact %}<sup class="th-note" aria-hidden="true">5</sup>{% endif %}</th><th scope="col" class="num">Result</th><th scope="col">Call</th>{% endif %}
    </tr>
  </thead>
  {% for day in days %}
  <tbody class="fx-day" data-day="{{ day.day }}">
    <tr class="fx-day-row"><th scope="rowgroup" colspan="{{ 10 + (1 if by else 0) }}">{{ day.label }}</th></tr>
    {% for r in day.rows %}
    <tr class="fx" data-match="{{ r.id }}" data-start="{{ r.start }}" data-league="{{ r.league }}" data-teams="{{ r.name1 }}|{{ r.name2 }}"{% if r.winner %} data-winner="{{ r.winner }}"{% endif %}>
      <td class="fx-time"><time datetime="{{ r.start | replace('Z', ':00Z') }}">{{ r.time }}</time><span class="fx-meta">{{ league(r.league, show_code=False) }}</span></td>
      <td class="wide-only fx-lg" title="{{ r.event }}">{{ league(r.league) }}</td>
      {% for side in [1, 2] %}
      {% set name = r['name' ~ side] %}{% set slug = r['slug' ~ side] %}
      {% set cls = 'fx-fav' if r.fav == side else ('fx-dog' if r.fav else '') %}
      {% if side == 2 %}
      <td class="fx-bar-col" aria-hidden="true" title="Called by {{ r.method }}{{ ' alone, across leagues' if r.cross }}{% if r.mkt1 %}; Kalshi {{ r.mkt1 }}–{{ r.mkt2 }}, {{ r.mkt_at }}{% endif %}"><span class="fx-bar" style="--p: {{ r.pct1 }}">{% if r.mkt1 %}<span class="fx-mkt" style="--m: {{ r.mkt1 }}"></span>{% endif %}</span></td>
      {% endif %}
      {% if side == 1 %}
      <td class="fx-team fx-team--1 {{ cls }}{% if r.winner == 1 %} fx-won{% endif %}" title="{{ name }}">{% if slug %}<a href="{{ root }}teams/{{ slug }}.html">{{ name }}</a>{% else %}{{ name }}{% endif %}</td>
      <td class="num fx-pct {{ cls }}">{{ r.pct1 }}</td>
      {% else %}
      <td class="fx-pct {{ cls }}">{{ r.pct2 }}</td>
      <td class="fx-team fx-team--2 {{ cls }}{% if r.winner == 2 %} fx-won{% endif %}" title="{{ name }}">{% if slug %}<a href="{{ root }}teams/{{ slug }}.html">{{ name }}</a>{% else %}{{ name }}{% endif %}</td>
      {% endif %}
      {% endfor %}
      {% if not results %}<td class="fx-bo">Bo{{ r.best_of }}</td>{% endif %}
      {% if not results %}<td class="num phone-hide fx-opt fx-game">{% if r.best_of > 1 %}{{ r.game1 }}–{{ r.game2 }}{% else %}<span class="muted">same</span>{% endif %}</td>{% endif %}
      {% if not results %}<td class="num phone-hide fx-market"{% if r.mkt1 %} title="As of {{ r.mkt_at }}; opens the match on Kalshi"{% endif %}>{% if r.mkt1 and r.mkt_url %}<a href="{{ r.mkt_url }}" aria-label="Kalshi’s market for {{ r.name1 }} against {{ r.name2 }}: {{ r.mkt1 }}–{{ r.mkt2 }}">{{ r.mkt1 }}–{{ r.mkt2 }}</a>{% elif r.mkt1 %}{{ r.mkt1 }}–{{ r.mkt2 }}{% else %}<span class="muted" title="No Kalshi market, or too thin a quote">—</span>{% endif %}</td>{% endif %}
      {% if by %}<td class="wide-only fx-opt fx-by">{{ r.method }}{% if r.cross %}<span class="fx-cross" title="Teams from different leagues: Elo alone"> across</span>{% endif %}</td>{% endif %}
      {% if results %}
      <td class="num phone-hide fx-close fx-market"{% if r.mkt1 %} title="Kalshi’s last price before the start ({{ r.mkt_at }}); opens the match on Kalshi"{% endif %}>{% if r.mkt1 and r.mkt_url %}<a href="{{ r.mkt_url }}" aria-label="Kalshi’s closing line for {{ r.name1 }} against {{ r.name2 }}: {{ r.mkt1 }}–{{ r.mkt2 }}">{{ r.mkt1 }}–{{ r.mkt2 }}</a>{% elif r.mkt1 %}{{ r.mkt1 }}–{{ r.mkt2 }}{% else %}<span class="muted" title="No Kalshi market, or too thin a quote">—</span>{% endif %}</td>
      <td class="num fx-score" title="Best of {{ r.best_of }}">{{ r.score or '—' }}</td>
      <td class="fx-call fx-call--{{ r.call or 'pending' }}">{% if r.call == 'right' %}Right{% elif r.call == 'missed' %}Missed{% elif r.call == 'even' %}Even{% else %}<i>To come</i>{% endif %}{% if r.reconstructed %}<a class="note-ref" href="#note-3" aria-label="Rebuilt after the match: note 3">3</a>{% endif %}</td>
      {% endif %}
    </tr>
    {% endfor %}
  </tbody>
  {% endfor %}
</table>
{%- endmacro %}

{#- The filter line over fixture registers (predictions.js): leagues, with the
    major-league default and an all-leagues shortcut, and a team search. -#}
{% macro filter_line(view) -%}
      <div class="filter-line" role="group" aria-label="Filters" hidden>
        <span class="filter-lead">Filter</span>
        <details class="picker" data-filter="leagues">
          <summary><span class="picker-label">leagues</span> <span class="picker-value" data-all="All" data-majors="Majors">Majors</span></summary>
          <fieldset class="picker-panel picker-panel--leagues">
            <legend class="picker-legend">Leagues</legend>
            <button type="button" class="picker-shortcut" data-select="{{ view.major_set | join(',') }}">Major leagues and international events</button>
            <button type="button" class="picker-shortcut" data-select="">All leagues</button>
            <div class="picker-options">
              {% for l in view.leagues %}
              <label data-league="{{ l }}"><input type="checkbox" value="{{ l }}" /> <span class="league-mark" aria-hidden="true"></span>{{ l }}</label>
              {% endfor %}
            </div>
          </fieldset>
        </details>
        <label class="filter-search" for="filter-search">
          <span class="picker-label">team</span>
          <input id="filter-search" type="search" placeholder="Any" autocomplete="off" spellcheck="false" />
        </label>
        <button type="button" class="clear-filters" hidden>Clear filters</button>
      </div>
{%- endmacro %}
