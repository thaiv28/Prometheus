{% extends 'base.html.j2' %}
{% block title %}Page not found · Prometheus{% endblock %}
{% block description %}This page doesn't exist on Prometheus.{% endblock %}
{% block content %}
  <div class="spread">
    <div class="spread-main">
      <header class="section-head">
        <h1>Page not found</h1>
        <p class="lede">Nothing exists at this address. Use the search at the top to find a team, or go to one of the pages below.</p>
      </header>
      <ol class="contents contents--errata">
        <li><a href="{{ root_path }}index.html"><span class="contents-name">Home</span><span class="leader" aria-hidden="true"></span><span class="contents-count">Overview</span></a></li>
        {% for group in nav %}{% for item in group.links %}
        <li><a href="{{ root_path }}{{ item.key }}.html"><span class="contents-name">{{ item.name }}</span><span class="leader" aria-hidden="true"></span><span class="contents-count">{{ group.name }}</span></a></li>
        {% endfor %}{% endfor %}
        <li><a href="{{ root_path }}sunset.html"><span class="contents-name">Sunset stats</span><span class="leader" aria-hidden="true"></span><span class="contents-count">Retired metrics</span></a></li>
      </ol>
    </div>
  </div>
{% endblock %}
