{% extends 'base.html.j2' %}
{% from '_marks.html.j2' import league, signed, ordinal %}
{% block title %}Prometheus · LoL esports rankings across eras and regions{% endblock %}
{% block content %}
  <section class="title-page" aria-labelledby="title">
    <h1 id="title">Prometheus</h1>
    <p class="title-sub">League of Legends esports rankings of teams and players, compared across years and regions, {{ first_year }} to today.</p>
    <p class="title-edition"><span>{{ '{:,}'.format(total_team_seasons) }} team-seasons</span> <span>{{ '{:,}'.format(total_elo_teams) }} teams rated</span> <span>Updated {{ last_update }}</span></p>
  </section>

  <div class="spread spread--home">
    <div class="spread-main">
      <div class="prose intro">
        <p class="lede">Prometheus rates teams and players. For teams it keeps two kinds of numbers: season stats describe a finished season with hindsight (GLORY measures how well a team played), and forecasts (GlorELO+, Form and Elo) estimate who wins the next game from earlier games only, tested against every game since 2014. Team Elo is built from player ratings, which follow each player through their career.</p>
      </div>

      <figure class="register-figure" aria-labelledby="t1-cap">
        <figcaption id="t1-cap" class="table-caption">Top 15 GLORY team-seasons, {{ first_year }}–{{ last_year }}. <a href="glory.html">See all GLORY rankings</a></figcaption>
        <div class="table-scroll">
          <table class="register">
            <thead>
              <tr>
                <th scope="col" class="num rank">Rk</th>
                <th scope="col">Team</th>
                <th scope="col" class="num wide-only">Year</th>
                <th scope="col" class="wide-only">League</th>
                <th scope="col" class="bar-col" aria-hidden="true"></th>
                <th scope="col" class="num">GLORY</th>
                <th scope="col" class="num phone-hide">Era Z</th>
              </tr>
            </thead>
            <tbody>
              {% for r in all_time %}
              <tr>
                <td class="num rank">{{ loop.index }}</td>
                <td class="team"><a href="teams/{{ r.slug }}.html">{{ r.teamname }}</a><span class="team-meta">{{ league(r.league, show_code=False) }}{{ r.year }}</span></td>
                <td class="num wide-only">{{ r.year }}</td>
                <td class="wide-only">{{ league(r.league) }}</td>
                <td class="bar-col" aria-hidden="true"><span class="bar" style="--v: {{ r.score }}"></span></td>
                <td class="num value">{{ '%.2f' | format(r.score) }}</td>
                <td class="num phone-hide">{{ signed(r.era_score) }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </figure>

      <figure class="register-figure" aria-labelledby="t2-cap">
        <figcaption id="t2-cap" class="table-caption">Best GLORY team-season each year. Teams is how many ranked team-seasons that year had.</figcaption>
        <div class="table-scroll">
          <table class="register">
            <thead>
              <tr>
                <th scope="col" class="num">Year</th>
                <th scope="col">Team</th>
                <th scope="col" class="wide-only">League</th>
                <th scope="col" class="bar-col" aria-hidden="true"></th>
                <th scope="col" class="num">GLORY</th>
                <th scope="col" class="num phone-hide">Teams</th>
              </tr>
            </thead>
            <tbody>
              {% for r in annual %}
              <tr>
                <td class="num year">{{ r.year }}</td>
                <td class="team"><a href="teams/{{ r.slug }}.html">{{ r.teamname }}</a><span class="team-meta team-meta--league">{{ league(r.league) }}</span></td>
                <td class="wide-only">{{ league(r.league) }}</td>
                <td class="bar-col" aria-hidden="true"><span class="bar" style="--v: {{ r.score }}"></span></td>
                <td class="num value">{{ '%.2f' | format(r.score) }}</td>
                <td class="num phone-hide muted">{{ r.field }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </figure>
    </div>

    <aside class="margin" aria-labelledby="contents-heading">
      <h2 id="contents-heading" class="margin-head">Rankings</h2>
      {% for section in sections %}
      <h3 class="contents-part">{{ section.name }}</h3>
      {% for group in section.groups %}
      {% set unit = 'players' if section.name == 'Players' else ('team-seasons' if group.name == 'Season stats' else 'teams') %}
      <h4 class="contents-section">{{ group.name }}</h4>
      <ol class="contents">
        {% for m in group.metrics %}
        <li>
          <a href="{{ m.key }}.html"><span class="contents-name">{{ m.title or m.name }}</span><span class="leader" aria-hidden="true"></span><span class="contents-count">{{ '{:,}'.format(entry_counts[m.key]) }}<span class="visually-hidden"> {{ unit }}</span></span></a>
          <p class="contents-full">{{ m.full_name }}</p>
          <p class="contents-desc">{{ m.description }}</p>
        </li>
        {% endfor %}
      </ol>
      {% endfor %}
      {% endfor %}
      <p class="margin-note">Counts are team-seasons for season stats, teams for team forecasts, and players active in the last six months for player Elo. Select any name to see its history. Retired metrics are listed under <a href="sunset.html">Sunset stats</a>.</p>
    </aside>
  </div>
{% endblock %}
