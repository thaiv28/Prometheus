{% extends 'base.html.j2' %}
{% from '_banner.html.j2' import banner %}
{% block title %}Prometheus · LoL esports rankings across eras and regions{% endblock %}
{% block content %}
  <section class="intro">
    <h1>Every season, ranked against its own era.</h1>
    <p class="lede">Prometheus scores League of Legends esports teams with sabermetric-style models refit for every season's meta, so a {{ first_year }} team and a {{ last_year }} team can stand side by side. {{ '{:,}'.format(total_team_seasons) }} team-seasons from LCK, LPL, LEC and LCS, plus Elo for every region.</p>
  </section>

  <section class="rafters-section" aria-labelledby="all-time-heading">
    <div class="section-head">
      <h2 id="all-time-heading">Highest GLORY team-seasons, {{ first_year }}–{{ last_year }}</h2>
      <a class="more" href="glory.html">Full GLORY rankings</a>
    </div>
    <ol class="rafters">
      {% for r in all_time %}
      {{ banner('teams/' ~ r.slug ~ '.html', r.league, r.score, loop.index,
                title=r.teamname, meta=r.year ~ ' · ' ~ r.league,
                label='#' ~ loop.index ~ ' ' ~ r.teamname ~ ', ' ~ r.year ~ ' ' ~ r.league ~ ', GLORY ' ~ '%.2f' | format(r.score)) }}
      {% endfor %}
    </ol>
  </section>

  <section class="metric-index" aria-labelledby="metrics-heading">
    <h2 id="metrics-heading">The metrics</h2>
    <dl>
      {% for m in metrics %}
      <div class="metric-entry">
        <dt><a href="{{ m.key }}.html"><span class="metric-name">{{ m.name }}</span> <span class="metric-full">{{ m.full_name }}</span></a></dt>
        <dd>{{ m.description }}</dd>
      </div>
      {% endfor %}
    </dl>
  </section>
{% endblock %}
