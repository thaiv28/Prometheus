{% extends 'base.html.j2' %}
{% from '_marks.html.j2' import fixtures, league, filter_line %}
{% block title %}Predictions · Prometheus{% endblock %}
{% block description %}{{ metric.description }}{% endblock %}
{% block canonical_path %}predictions.html{% endblock %}
{% block head_extra %}<link rel="stylesheet" href="{{ asset('css/live.css') }}" />{% endblock %}
{% block content %}
  <div class="spread spread--wide">
    <div class="spread-main">
      <header class="section-head">
        <h1>{{ metric.name }}</h1>
        <p class="lede">Calls freeze at start.{% if games_through %} Data through {{ games_through }}.{% endif %}<a class="note-ref" href="#note-3" aria-label="Note 3">3</a> <a href="call-performance.html">Record</a></p>
      </header>

  <section hidden class="live live--overview" id="live-overview" data-index="live/index.json">
    <header class="section-head live-overview-head">
      <h2>Live now</h2>
    </header>

    <section class="live-matches" aria-labelledby="matches-cap">
      <figure class="register-figure">
        <figcaption id="matches-cap" class="table-caption" role="status">Table I. <span id="matches-caption">Matches in progress.</span></figcaption>
        <div class="table-scroll">
          <table class="register register--matches" id="matches" hidden>
            <thead>
              <tr>
                <th scope="col" class="lm-clock">Clock</th>
                <th scope="col" class="lm-league wide-only">League</th>
                <th scope="col" class="lm-team lm-team--1"><span class="visually-hidden">First team</span></th>
                <th scope="colgroup" colspan="3" class="lm-chance-head" title="Each team's chance to win the map, by our latest call; the caret is Kalshi's">Our call<a class="note-ref" href="#note-5" aria-label="Note 5">5</a></th>
                <th scope="col" class="lm-team lm-team--2"><span class="visually-hidden">Second team</span></th>
                <th scope="col" class="num lm-opt" title="Kalshi's chance for the first team">Kalshi<a class="note-ref" href="#note-6" aria-label="Note 6">6</a></th>
                <th scope="col" class="num lm-series">Series</th>
                <th scope="col" class="num lm-stat" title="Gold lead">Gold</th>
                <th scope="col" class="num lm-stat">Kills</th>
                <th scope="col" class="num lm-stat lm-wide"><span class="th-long">Towers</span><abbr class="th-short" title="Towers">Twr</abbr></th>
                <th scope="col" class="num lm-stat lm-wide"><span class="th-long">Dragons</span><abbr class="th-short" title="Dragons">Drg</abbr></th>
                <th scope="col" class="num lm-stat lm-wide"><span class="th-long">Barons</span><abbr class="th-short" title="Barons">Bar</abbr></th>
              </tr>
            </thead>
          </table>
        </div>
      </figure>
    </section>

  </section>

      {{ filter_line(view) }}

      <section id="upcoming-section" class="fixtures-block" aria-labelledby="upcoming-heading">
        <div class="block-head">
          <h2 id="upcoming-heading">Coming up</h2>
        </div>
        <figure class="register-figure" aria-labelledby="upcoming-cap">
          <figcaption id="upcoming-cap" class="table-caption">Table II. <a class="note-ref" href="#note-dagger" aria-label="Caveat">†</a> <span class="count" data-count-for="upcoming" aria-live="polite">{{ view.upcoming_count }} matches.</span></figcaption>
          {% if view.upcoming %}
          <div class="table-scroll">{{ fixtures(view.upcoming, id='upcoming') }}</div>
          {% endif %}
          <p class="empty fx-empty" data-empty-for="upcoming"{% if view.upcoming %} hidden{% endif %}>{% if view.upcoming %}No matching fixtures.{% else %}No rated fixtures this week.{% endif %}</p>
        </figure>
      </section>

      <section class="fixtures-block" aria-labelledby="past-heading">
        <div class="block-head">
          <h2 id="past-heading">Results</h2>
          <a class="more" href="predictions.json">Download calls</a>
        </div>
        <figure class="register-figure register-figure--main" aria-labelledby="past-cap">
          <figcaption id="past-cap" class="table-caption">Table III. Last {{ view.recent_days }} days. <span class="count" data-count-for="past" aria-live="polite"></span></figcaption>
          {% if view.past %}
          <div class="table-scroll">{{ fixtures(view.past, results=True, compact=True, id='past') }}</div>
          {% endif %}
          <p class="empty fx-empty" data-empty-for="past"{% if view.past %} hidden{% endif %}>{% if view.past %}No matching results.{% else %}No recent results.{% endif %}</p>
        </figure>
        {% if view.months %}
        <p class="month-index"><span class="month-index-lead">By month</span> {% for m in view.months %}<a href="results/{{ m.key }}.html">{{ m.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
        {% endif %}
      </section>
    </div>

    <aside class="margin notes" id="about" aria-labelledby="about-heading">
      <h2 id="about-heading" class="margin-head">Reading the odds</h2>
      <ol class="notes-list">
        {% for line in metric.how_to_read[:3] %}
        <li id="note-{{ loop.index }}"><span class="note-mark" aria-hidden="true">{{ loop.index }}</span>{{ line }}</li>
        {% endfor %}
        <li id="note-4"><span class="note-mark" aria-hidden="true">4</span>Kalshi refreshes hourly; its caret marks the bar. Blend combines Kalshi with FORGE/Elo. CLV: close minus ask, in points. <a href="market-blend.html">Method</a>.</li>
        <li id="note-5"><span class="note-mark" aria-hidden="true">5</span>Ours: FORGE before the map, then gold and Elo through it.</li>
        <li id="note-6"><span class="note-mark" aria-hidden="true">6</span>Kalshi: the market’s price.</li>
        <li id="note-7"><span class="note-mark" aria-hidden="true">7</span>Research preview: the in-game clock is estimated.</li>
        <li id="note-dagger" class="caveat"><span class="note-mark" aria-hidden="true">†</span><span class="visually-hidden">Caveat: </span>{{ metric.caveats }}{% if coverage %} {{ coverage.matched }}/{{ coverage.matches }} fixtures rated.{% endif %}</li>
      </ol>
    </aside>
  </div>
{% endblock %}
{% block scripts %}
  <script src="{{ asset('js/live_state.js') }}" defer></script>
  <script src="{{ asset('js/live_overview.js') }}" defer></script>
  <script src="{{ asset('js/predictions.js') }}" defer></script>
{% endblock %}
