{% extends 'base.html.j2' %}
{% from '_marks.html.j2' import league, ordinal %}
{% from '_entry.html.j2' import contents, game_log, game_log_note %}
{% block title %}{{ teamname }} · Prometheus{% endblock %}
{% block description %}{{ teamname }}: Elo history, GLORY and FORGE by season, rosters and every game.{% endblock %}
{% block canonical_path %}teams/{{ slug }}.html{% endblock %}
{% set toc = [] %}
{% if elo_series %}{% set _ = toc.append(('elo', 'Elo', elo_summary.last.elo | round | int)) %}{% endif %}
{% if series %}{% set _ = toc.append(('seasons', 'Season by season', series | length)) %}{% endif %}
{% if roster %}{% set _ = toc.append(('roster', 'Roster', none)) %}{% endif %}
{% if games %}{% set _ = toc.append(('games', 'Games', '{:,}'.format(games.games))) %}{% endif %}
{% block head_extra %}<link rel="stylesheet" href="../{{ asset('css/entry.css') }}" />{% endblock %}
{% block content %}
  <header class="entry-head">
    <h1>{{ teamname }}</h1>
    <p class="entry-facts">
      {% for l in leagues %}<span>{{ league(l) }}</span>{% endfor %}
      {% if series %}<span>{{ series | length }} season{{ 's' if series | length != 1 }} ranked, {{ series[0].year }}{% if series | length > 1 %}–{{ series[-1].year }}{% endif %}</span>{% endif %}
      {% if current_forge is not none %}<span>FORGE {{ current_forge }}</span>{% endif %}
      {% if current_elo is not none %}<span>Elo {{ current_elo }}</span>{% endif %}
    </p>
    <p class="entry-summary">
      {%- if best -%}
      Best GLORY season {{ best.year }}, scoring {{ '%.2f' | format(best.glory) }}{% if best.year_rank %}, {{ ordinal(best.year_rank) }} of {{ best.field }} major-league teams that year{% endif %}.
      {%- endif %}
      {% if elo_summary -%}
      Elo peaked at {{ elo_summary.peak.elo | round | int }} on {{ elo_summary.peak.date | longdate }} and was {{ elo_summary.last.elo | round | int }} after its latest game on {{ elo_summary.last.date | longdate }}.
      {%- endif %}
    </p>
  </header>
  {{ contents(toc, 'inline') }}

  <div class="spread">
    <div class="spread-main">
      {% if elo_series %}
      <section class="elo" id="elo" aria-labelledby="elo-heading">
        <div class="block-head">
          <h2 id="elo-heading">Elo after every game</h2>
          <a class="more" href="../game_length_elo.html?search={{ teamname | urlencode }}">See in Elo rankings</a>
        </div>
        <figure class="elo-figure" data-league="{{ current_league or (leagues[0] if leagues else '') }}" aria-labelledby="elo-fig-cap">
          <figcaption id="elo-fig-cap" class="figure-caption">Elo from {{ elo_summary.first.date | longdate }} to {{ elo_summary.last.date | longdate }}. The dashed line marks 1500, where the first teams started.</figcaption>
          <div class="elo-plot" id="elo-plot" tabindex="0" role="img"
               aria-label="{{ teamname }} Elo over {{ elo_summary.games }} games: started {{ elo_summary.first.elo | round | int }}, peak {{ elo_summary.peak.elo | round | int }} on {{ elo_summary.peak.date }}, low {{ elo_summary.low.elo | round | int }} on {{ elo_summary.low.date }}, latest {{ elo_summary.last.elo | round | int }}. Use the left and right arrow keys to read individual games."></div>
          <p class="elo-readout" id="elo-readout" aria-live="polite"></p>
          <dl class="elo-stats">
            <div><dt>Games</dt><dd>{{ '{:,}'.format(elo_summary.games) }}</dd></div>
            <div><dt>Peak</dt><dd>{{ elo_summary.peak.elo | round | int }} <span class="muted">{{ elo_summary.peak.date | longdate }}</span></dd></div>
            <div><dt>Low</dt><dd>{{ elo_summary.low.elo | round | int }} <span class="muted">{{ elo_summary.low.date | longdate }}</span></dd></div>
            <div><dt>Latest</dt><dd>{{ elo_summary.last.elo | round | int }} <span class="muted">{{ elo_summary.last.date | longdate }}</span></dd></div>
          </dl>
        </figure>
      </section>
      {% endif %}

      {% if series %}
      {% set ns = namespace(top=100) %}
      {% for s in series %}{% if s.glory is not none and s.glory > ns.top %}{% set ns.top = s.glory %}{% endif %}{% endfor %}
      <section class="seasons" id="seasons" aria-labelledby="seasons-heading">
        <div class="block-head">
          <h2 id="seasons-heading">Season by season</h2>
        </div>
        <figure class="season-figure" aria-labelledby="season-fig-cap">
          <figcaption id="season-fig-cap" class="figure-caption">GLORY by season (scale 0 to {{ ns.top | round | int }}).</figcaption>
          <ol class="season-chart" id="season-chart" style="--n: {{ series | length }}">
            {% for s in series %}
            <li class="season-col" data-league="{{ s.league }}"
                style="--v: {{ ((s.glory if s.glory is not none and s.glory > 0 else 0) / ns.top * 100) | round(2) }}">
              <span class="season-val">{{ ('%.1f' | format(s.glory)) | replace('-', '−') if s.glory is not none else '—' }}</span>
              <span class="season-bar" aria-hidden="true"></span>
              <span class="season-year">{{ s.year }}<span class="league-mark" aria-hidden="true"></span></span>
            </li>
            {% endfor %}
          </ol>
        </figure>

        <figure class="register-figure" aria-labelledby="season-table-cap">
          <figcaption id="season-table-cap" class="table-caption">Year rank compares the team with major-league teams that played 5 or more games that year. FORGE is the forecast rating (Elo plus Form) at the end of each season.</figcaption>
          <div class="table-scroll">
            <table class="register">
              <thead>
                <tr>
                  <th scope="col" class="num">Year</th>
                  <th scope="col" class="phone-hide">League</th>
                  <th scope="col" class="num">GLORY</th>
                  <th scope="col" class="num">Year rank</th>
                  <th scope="col" class="num">FORGE</th>
                </tr>
              </thead>
              <tbody>
                {% for s in series | sort(attribute='year', reverse=True) %}
                <tr>
                  <td class="num year">{{ s.year }}</td>
                  <td class="phone-hide">{{ league(s.league) }}</td>
                  <td class="num value">{{ ('%.2f' | format(s.glory)) | replace('-', '−') if s.glory is not none else '—' }}</td>
                  <td class="num muted">{% if s.year_rank %}{{ ordinal(s.year_rank) }} <span class="of">of {{ s.field }}</span>{% else %}<span title="Fewer than 5 games">Unranked</span>{% endif %}</td>
                  <td class="num">{{ s.forge if s.forge is not none else '—' }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </figure>
      </section>
      {% else %}
      <p class="section-note">GLORY only covers LCK, LPL, LEC and LCS teams, so this team has no season table.</p>
      {% endif %}

      {% if roster %}
      {% set roles = {'top': 'Top', 'jng': 'Jungle', 'mid': 'Mid', 'bot': 'Bot', 'sup': 'Support'} %}
      {% macro player_name(p) %}{% if p.slug %}<a href="../players/{{ p.slug }}.html">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}{% endmacro %}
      <section class="rosters" id="roster" aria-labelledby="roster-heading">
        <div class="block-head">
          <h2 id="roster-heading">{{ 'Roster' if roster.last.active else 'Last roster' }}</h2>
        </div>
        <figure class="register-figure" aria-labelledby="roster-cap">
          <figcaption id="roster-cap" class="table-caption">The five who started {{ 'the latest' if roster.last.active else 'its last' }} game, on {{ roster.last.date | longdate }}. Elo is each player’s rating today.</figcaption>
          <table class="register register--roster">
            <thead>
              <tr>
                <th scope="col">Role</th>
                <th scope="col">Player</th>
                <th scope="col" class="num">Elo</th>
              </tr>
            </thead>
            <tbody>
              {% for p in roster.last.players %}
              <tr>
                <td class="muted">{{ roles.get(p.role, p.role) }}</td>
                <td class="team">{{ player_name(p) }}</td>
                <td class="num value">{{ p.elo if p.elo is not none else '—' }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </figure>

        <figure class="register-figure" aria-labelledby="rosters-cap">
          <figcaption id="rosters-cap" class="table-caption">Starters by season and role. The main starter comes first; others follow with the games they started.</figcaption>
          <div class="table-scroll">
            <table class="register register--lineups">
              <thead>
                <tr>
                  <th scope="col" class="num">Year</th>
                  {% for r in ['top', 'jng', 'mid', 'bot', 'sup'] %}<th scope="col">{{ roles[r] }}</th>{% endfor %}
                </tr>
              </thead>
              <tbody>
                {% for s in roster.seasons %}
                <tr>
                  <td class="num year">{{ s.year }}</td>
                  {% for cell in s.roles %}
                  <td class="lineup" data-role="{{ roles[cell.role] }}"><span class="lineup-names">
                    {%- for p in cell.players -%}
                    {%- if loop.first %}<span class="lineup-main">{{ player_name(p) }}</span>
                    {%- else %}<span class="lineup-sub">{{ player_name(p) }} <span class="lineup-games">{{ p.games }}</span></span>{% endif -%}
                    {%- else %}<span class="muted">—</span>{%- endfor -%}
                    {%- if cell.more %}<span class="lineup-sub muted">+{{ cell.more }} more</span>{% endif -%}
                  </span></td>
                  {% endfor %}
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </figure>
      </section>
      {% endif %}

      {% if games %}{{ game_log(games, 'team', teamname, 5) }}{% endif %}
    </div>

    <aside class="margin notes" aria-labelledby="entry-notes-heading">
      {{ contents(toc, 'margin') }}
      <h2 id="entry-notes-heading" class="margin-head">Key terms</h2>
      <ol class="notes-list">
        <li><span class="note-mark" aria-hidden="true">1</span><a href="../glory.html">GLORY</a> scores how well a team played: the stats that won games that year, adjusted for opponents, roughly 0 to 100.</li>
        <li><span class="note-mark" aria-hidden="true">2</span>Seasons with fewer than 5 games get a score but no rank (Unranked).</li>
        <li><span class="note-mark" aria-hidden="true">3</span><a href="../forge.html">FORGE</a> is the forecast: Elo plus recent Form, at the end of each season.</li>
        <li><span class="note-mark" aria-hidden="true">4</span><a href="../game_length_elo.html">Elo</a> is the average of the five starters' player ratings and moves most after short, decisive games. Compare ratings within a region.</li>
        {% if games %}{{ game_log_note(false, 5) }}{% endif %}
      </ol>
      {% if series %}<p class="margin-note"><a href="../glory.html?search={{ teamname | urlencode }}">Show {{ teamname }} in GLORY rankings</a></p>{% endif %}
    </aside>
  </div>

  <script type="application/json" id="elo-series">{{ elo_series | compact_series | tojson }}</script>
{% endblock %}
{% block scripts %}
  <script src="../{{ asset('js/team.js') }}" defer></script>
  <script src="../{{ asset('js/entry.js') }}" defer></script>
{% endblock %}
