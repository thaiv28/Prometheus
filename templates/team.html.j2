{% extends 'base.html.j2' %}
{% block title %}{{ teamname }} · Prometheus{% endblock %}
{% block description %}{{ teamname }}: GLORY and GLORB by season and Elo history.{% endblock %}
{% block canonical_path %}teams/{{ slug }}.html{% endblock %}
{% block content %}
  <section class="page-head team-head">
    <h1>{{ teamname }}</h1>
    <ul class="team-facts">
      {% for l in leagues %}<li><span class="league-tag" data-league="{{ l }}">{{ l }}</span></li>{% endfor %}
      {% if series %}<li>{{ series | length }} season{{ 's' if series | length != 1 }} ranked ({{ series[0].year }}–{{ series[-1].year }})</li>{% endif %}
      {% if current_elo is not none %}<li>Elo <strong>{{ current_elo }}</strong></li>{% endif %}
    </ul>
  </section>

  {% if series %}
  <section class="rafters-section" aria-labelledby="seasons-heading">
    <div class="section-head">
      <h2 id="seasons-heading">Season by season</h2>
      <div class="segmented" role="radiogroup" aria-label="Metric">
        <label><input type="radio" name="team-metric" value="glory" checked /> GLORY</label>
        <label><input type="radio" name="team-metric" value="glorb" /> GLORB</label>
      </div>
    </div>
    <ol class="rafters rafters--seasons" id="season-rafters" style="--n: {{ series | length }}">
      {% for s in series %}
      <li class="banner{% if s.glory is none %} banner--empty{% endif %}" data-league="{{ s.league }}"
          data-glory="{{ s.glory if s.glory is not none else '' }}" data-glorb="{{ s.glorb if s.glorb is not none else '' }}">
        <div class="banner-link">
          <span class="banner-felt"><span class="banner-numeral">{{ s.year }}</span></span>
          <span class="banner-caption"><span class="banner-meta">{{ s.league }}</span><span class="banner-value">{{ '%.2f' | format(s.glory) if s.glory is not none else '—' }}</span></span>
        </div>
      </li>
      {% endfor %}
    </ol>
  </section>
  {% else %}
  <p class="section-note">GLORY and GLORB cover LCK, LPL, LEC and LCS, so this team has Elo only.</p>
  {% endif %}

  {% if elo_series %}
  <section class="elo-section" aria-labelledby="elo-heading">
    <div class="section-head">
      <h2 id="elo-heading">Elo after every game</h2>
      <a class="more" href="../game_length_elo.html?search={{ teamname | urlencode }}">Compare on the Elo table</a>
    </div>
    <div class="chart-frame" data-league="{{ current_league or (leagues[0] if leagues else '') }}">
      <canvas id="elo-chart" role="img" aria-label="{{ teamname }} Elo rating over {{ elo_series | length }} games, from {{ elo_series[0].date }} to {{ elo_series[-1].date }}"></canvas>
    </div>
  </section>
  {% endif %}

  {% if series %}
  <section aria-labelledby="table-heading">
    <h2 id="table-heading" class="visually-hidden">Seasons table</h2>
    <div class="table-wrap">
      <table class="rankings rankings--compact">
        <thead><tr><th scope="col">Year</th><th scope="col">League</th><th scope="col" class="num">GLORY</th><th scope="col" class="num">GLORB</th></tr></thead>
        <tbody>
          {% for s in series | sort(attribute='year', reverse=True) %}
          <tr>
            <td>{{ s.year }}</td>
            <td><span class="league-tag" data-league="{{ s.league }}">{{ s.league }}</span></td>
            <td class="num">{{ '%.2f' | format(s.glory) if s.glory is not none else '—' }}</td>
            <td class="num">{{ '%.2f' | format(s.glorb) if s.glorb is not none else '—' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}

  <script type="application/json" id="elo-series">{{ elo_series | tojson }}</script>
{% endblock %}
{% block scripts %}
  {% if elo_series %}<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" defer></script>{% endif %}
  <script src="../js/team.js" defer></script>
{% endblock %}
