{% extends 'base.html.j2' %}
{% from '_marks.html.j2' import fixtures, filter_line %}
{% block title %}{{ view.name }} results, {{ month.label }} · Prometheus{% endblock %}
{% block description %}Every {{ view.name }} call for {{ month.label }} and its result.{% endblock %}
{% block canonical_path %}other/{{ view.game }}/{{ month.key }}.html{% endblock %}
{% block content %}
  <div class="spread spread--wide">
    <div class="spread-main">
      <header class="section-head">
        <h1>Results <span class="full-name">{{ month.label }} · {{ view.name }}</span></h1>
        <p class="lede"><a href="../{{ view.game }}.html">{{ view.name }}</a> calls and upcoming matches.</p>
      </header>

      {{ filter_line(view) }}

      <section class="fixtures-block" aria-labelledby="month-heading">
        <div class="block-head">
          <h2 id="month-heading" class="visually-hidden">{{ month.label }}</h2>
        </div>
        <figure class="register-figure register-figure--main" aria-labelledby="month-cap">
          <figcaption id="month-cap" class="table-caption">{{ month.label }}, newest first. <span class="count" data-count-for="past" aria-live="polite"></span></figcaption>
          <div class="table-scroll">{{ fixtures(month.days, results=True, id='past', lg_label='Tier') }}</div>
          <p class="empty fx-empty" data-empty-for="past" hidden>No result fits these filters.</p>
        </figure>
        <p class="month-index">{% if newer %}<a href="{{ newer.key }}.html" rel="prev">← {{ newer.label }}</a>{% endif %}{% if newer and older %} · {% endif %}{% if older %}<a href="{{ older.key }}.html" rel="next">{{ older.label }} →</a>{% endif %}</p>
      </section>
    </div>

    <aside class="margin notes" aria-labelledby="about-heading">
      <h2 id="about-heading" class="margin-head">Reading the results</h2>
      <p class="margin-note" id="note-1">Figures: series chances in 100.</p>
      <p class="margin-note" id="note-3">Marked calls were rebuilt after the match from the ratings before it.</p>
      <p class="margin-note" id="note-4">Close: Kalshi's last hourly price before the start.</p>
      <p class="margin-note">{{ view.model }}. Source: <a href="{{ view.source.url }}">{{ view.source.name }}</a>{% if view.source.license %} ({{ view.source.license }}){% endif %}.</p>
    </aside>
  </div>
{% endblock %}
{% block scripts %}
  <script src="{{ root_path }}{{ asset('js/predictions.js') }}" defer></script>
{% endblock %}
