{% set _root = root_path if root_path is defined else '' %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title>{% block title %}Prometheus{% endblock %}</title>
  {% set _desc %}{% block description %}Advanced League of Legends esports team and player rankings, comparable across eras and regions.{% endblock %}{% endset %}
  <meta name="description" content="{{ _desc | trim }}" />
  <link rel="canonical" href="{{ site_url }}/{% block canonical_path %}{% endblock %}" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Prometheus" />
  <meta property="og:title" content="{{ self.title() | trim }}" />
  <meta property="og:description" content="{{ _desc | trim }}" />
  <meta property="og:url" content="{{ site_url }}/{{ self.canonical_path() | trim }}" />
  <meta name="theme-color" content="#f3eee3" />
  <link rel="icon" href="{{ _root }}favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="{{ _root }}fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="{{ _root }}{{ asset('css/tokens.css') }}" />
  <link rel="stylesheet" href="{{ _root }}{{ asset('css/base.css') }}" />
  <link rel="stylesheet" href="{{ _root }}{{ asset('css/register.css') }}" />
  {% block head_extra %}{% endblock %}
</head>
<body data-page="{{ page_key }}">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="running-head">
    <a class="wordmark" href="{{ _root }}index.html"><svg class="wordmark-mark" viewBox="0 0 20 24" aria-hidden="true"><path d="M3 2h8.2C15.6 2 18 4.4 18 8s-2.4 6-6.8 6H8v8H3zM8 6v4h3c1.4 0 2.2-.8 2.2-2S12.4 6 11 6z"/></svg><span class="wordmark-text">Prometheus</span></a>
    <nav class="sections" aria-label="Sections">
      <a href="{{ _root }}index.html"{% if page_key == 'index' %} aria-current="page"{% endif %}>Home</a>
      <a href="{{ _root }}predictions.html"{% if page_key == 'predictions' %} aria-current="page"{% endif %}>Predictions</a>
      {#- One menu per entity. It is marked current on any of its stat pages, and on
          team, player, sunset and retired-metric pages for the menu that leads there. -#}
      {% for group in nav %}
      {% set keys = group.links | map(attribute='key') | list %}
      {% set here = page_key in keys or (group.name == 'Players' and page_key == 'player')
                    or (group.name == 'Teams' and (page_key in ['team', 'sunset'] or page_key in sunset_keys)) %}
      <details class="nav-menu">
        <summary{% if here %} data-current{% endif %}>{{ group.name }}</summary>
        <ul class="nav-menu-panel">
          {% for item in group.links %}
          <li><a href="{{ _root }}{{ item.key }}.html"{% if item.key == page_key %} aria-current="page"{% endif %}><span class="nav-menu-name">{{ item.name }}</span><span class="visually-hidden">: </span><span class="nav-menu-q">{{ item.question }}</span></a></li>
          {% endfor %}
          {% if group.name == 'Teams' %}
          <li class="nav-menu-sunset"><a href="{{ _root }}sunset.html"{% if page_key == 'sunset' %} aria-current="page"{% endif %}><span class="nav-menu-name">Sunset stats</span><span class="visually-hidden">: </span><span class="nav-menu-q">Retired metrics, and why</span></a></li>
          {% endif %}
        </ul>
      </details>
      {% endfor %}
    </nav>
    {# Goes to a team's or player's page. Without JS it falls back to the team Elo register, which lists every team. #}
    <form class="index-search" role="search" action="{{ _root }}game_length_elo.html" method="get" data-root="{{ _root }}" data-index="{{ _root }}teams.json" data-players="{{ _root }}players.json">
      <label for="team-search">Find</label>
      <input id="team-search" name="search" type="search" placeholder="Team or player" autocomplete="off" spellcheck="false"
             role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="team-search-results" />
      <ul class="index-search-results" id="team-search-results" role="listbox" aria-label="Teams and players" hidden></ul>
    </form>
  </header>
  <main id="main" class="page">
    {% block content %}{% endblock %}
  </main>
  <footer class="colophon">
    <p class="colophon-source">Data from <a href="https://oracleselixir.com/">Oracle’s Elixir</a>, updated daily. Last updated {{ last_update }}.</p>
    <p class="colophon-meta"><a href="https://github.com/thaiv28/Prometheus">Methodology and source code on GitHub</a></p>
  </footer>
  <script src="{{ _root }}{{ asset('js/names.js') }}" defer></script>
  <script src="{{ _root }}{{ asset('js/search.js') }}" defer></script>
  <script src="{{ _root }}{{ asset('js/nav.js') }}" defer></script>
  {% block scripts %}{% endblock %}
</body>
</html>
