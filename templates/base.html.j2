{% set _root = root_path if root_path is defined else '' %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="dark" />
  <title>{% block title %}Prometheus{% endblock %}</title>
  {% set _desc %}{% block description %}Advanced League of Legends esports team rankings, comparable across eras and regions.{% endblock %}{% endset %}
  <meta name="description" content="{{ _desc | trim }}" />
  <link rel="canonical" href="{{ site_url }}/{% block canonical_path %}{% endblock %}" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Prometheus" />
  <meta property="og:title" content="{{ self.title() | trim }}" />
  <meta property="og:description" content="{{ _desc | trim }}" />
  <meta property="og:url" content="{{ site_url }}/{{ self.canonical_path() | trim }}" />
  <meta name="theme-color" content="#1a1917" />
  <link rel="icon" href="{{ _root }}favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="{{ _root }}fonts/graduate-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="{{ _root }}css/tokens.css" />
  <link rel="stylesheet" href="{{ _root }}css/base.css" />
  <link rel="stylesheet" href="{{ _root }}css/rafters.css" />
  <link rel="stylesheet" href="{{ _root }}css/table.css" />
</head>
<body data-page="{{ page_key }}">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="topbar">
    <a class="wordmark" href="{{ _root }}index.html"><svg class="wordmark-mark" viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="3" width="26" height="3" rx="1.5"/><path d="M8 7h16v22l-8-5-8 5z"/></svg><span class="wordmark-text">Prometheus</span></a>
    <nav class="topnav" aria-label="Rankings">
      {% for item in nav %}
      <a href="{{ _root }}{{ item.key }}.html"{% if item.key == page_key %} aria-current="page"{% endif %}>{{ item.name }}</a>
      {% endfor %}
    </nav>
    <form class="search" role="search" action="{{ _root }}game_length_elo.html" method="get">
      <label class="visually-hidden" for="team-search">Search teams</label>
      <svg class="search-icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.75"/><path d="m10.5 10.5 3.5 3.5"/></svg>
      <input id="team-search" name="search" type="search" placeholder="Search teams" autocomplete="off" />
    </form>
  </header>
  <main id="main" class="page">
    {% block content %}{% endblock %}
  </main>
  <footer class="footer">
    <p>Data from <a href="https://oracleselixir.com/">Oracle's Elixir</a>. Updated {{ last_update }}.</p>
    <p><a href="https://github.com/thaiv28/Prometheus">Source and methodology on GitHub</a></p>
  </footer>
  {% block scripts %}{% endblock %}
</body>
</html>
