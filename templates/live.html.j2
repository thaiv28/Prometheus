{% extends 'base.html.j2' %}
{% from '_marks.html.j2' import fixtures as fixtures_table %}
{% block title %}Live · Prometheus{% endblock %}
{% block description %}{{ metric.description }}{% endblock %}
{% block canonical_path %}live.html{% endblock %}
{% block head_extra %}<link rel="stylesheet" href="{{ asset('css/live.css') }}" />{% endblock %}
{% block content %}
  {#- The Live home: every match in progress as one register, filled and kept
      current by live_overview.js from live/index.json (written by the live
      collector, not by the build). Each row opens the match on watch.html. -#}
  <div class="live live--overview" id="live-overview" data-index="live/index.json">
    <header class="section-head live-overview-head">
      <h1>{{ metric.name }}</h1>
      <noscript><p class="live-status">Needs JavaScript.</p></noscript>
    </header>

    <section class="live-matches" aria-labelledby="matches-cap">
      <figure class="register-figure">
        <figcaption id="matches-cap" class="table-caption" role="status">Table I. <span id="matches-caption">Matches in progress.</span></figcaption>
        <div class="table-scroll">
          <table class="register register--matches" id="matches" hidden>
            <thead>
              <tr>
                <th scope="col" class="lm-clock">Clock</th>
                <th scope="col" class="lm-league wide-only">League</th>
                <th scope="col" class="lm-team lm-team--1"><span class="visually-hidden">First team</span></th>
                <th scope="colgroup" colspan="3" class="lm-chance-head" title="Each team's chance to win the map, by our latest call; the caret is Kalshi's">Our call<sup class="th-note" aria-hidden="true">1</sup></th>
                <th scope="col" class="lm-team lm-team--2"><span class="visually-hidden">Second team</span></th>
                <th scope="col" class="num lm-opt" title="Kalshi's chance for the first team">Kalshi<sup class="th-note" aria-hidden="true">2</sup></th>
                <th scope="col" class="num lm-series">Series</th>
                <th scope="col" class="num lm-stat">Gold lead</th>
                <th scope="col" class="num lm-stat">Kills</th>
                <th scope="col" class="num lm-stat lm-wide"><span class="th-long">Towers</span><abbr class="th-short" title="Towers">Twr</abbr></th>
                <th scope="col" class="num lm-stat lm-wide"><span class="th-long">Dragons</span><abbr class="th-short" title="Dragons">Drg</abbr></th>
                <th scope="col" class="num lm-stat lm-wide"><span class="th-long">Barons</span><abbr class="th-short" title="Barons">Bar</abbr></th>
              </tr>
            </thead>
          </table>
          <p class="empty lm-empty" id="matches-empty">No matches on.</p>
        </div>
      </figure>
    </section>

    <section class="live-idle fixtures-block" aria-labelledby="idle-heading">
      <div class="block-head">
        <h2 id="idle-heading">Coming up</h2>
        <a class="more" href="predictions.html">Every prediction</a>
      </div>
      <figure class="register-figure fixtures-home" aria-labelledby="idle-cap">
        <figcaption id="idle-cap" class="table-caption">Table II. {% if fixtures %}Next major-league and international matches.{% else %}None in the next four days.{% endif %}</figcaption>
        {% if fixtures %}
        <div class="table-scroll">{{ fixtures_table(fixtures, compact=True) }}</div>
        {% endif %}
      </figure>
    </section>

    {% if finished is not none %}
    <section class="live-finished fixtures-block" aria-labelledby="finished-heading">
      <div class="block-head">
        <h2 id="finished-heading">Finished</h2>
      </div>
      <figure class="register-figure" aria-labelledby="finished-cap">
        <figcaption id="finished-cap" class="table-caption">Table III. {% if finished %}Followed live, last 7 days. A row opens its maps.{% else %}None in the last week.{% endif %}</figcaption>
        {% if finished %}
        <div class="table-scroll">{{ fixtures_table(finished, results=True, compact=True, id='finished') }}</div>
        {% endif %}
      </figure>
      {% if live_months %}
      <p class="month-index"><span class="month-index-lead">By month</span> {% for m in live_months %}<a href="live-results/{{ m.key }}.html">{{ m.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
      {% endif %}
    </section>
    {% endif %}

    <aside class="live-notes notes" aria-labelledby="notes-heading">
      <h2 id="notes-heading" class="margin-head">Notes</h2>
      <ol class="notes-list">
        {#- The delay note is for the watch page; nothing here is held back. -#}
        {% for line in metric.how_to_read[:2] %}
        <li id="note-{{ loop.index }}"><span class="note-mark" aria-hidden="true">{{ loop.index }}</span>{{ line }}</li>
        {% endfor %}
        <li id="note-dagger" class="caveat"><span class="note-mark" aria-hidden="true">†</span><span class="visually-hidden">Caveat: </span>{{ metric.caveats }}</li>
      </ol>
    </aside>
  </div>
{% endblock %}
{% block scripts %}
  {% if fixtures or finished %}<script src="{{ asset('js/predictions.js') }}" defer></script>{% endif %}
  <script src="{{ asset('js/live_state.js') }}" defer></script>
  <script src="{{ asset('js/live_overview.js') }}" defer></script>
{% endblock %}
