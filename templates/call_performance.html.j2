{% extends 'base.html.j2' %}
{% block title %}Call performance · Prometheus{% endblock %}
{% block canonical_path %}call-performance.html{% endblock %}
{% block head_extra %}<link rel="stylesheet" href="{{ asset('css/alerts.css') }}" />{% endblock %}
{% block content %}
<div class="spread spread--wide"><div class="spread-main">
  <header class="section-head"><h1>Call performance</h1><p class="lede">$1 per call, 12 hours before start. After fees. <a href="predictions.html">Predictions</a> · <a href="alerts.html">Alert history</a></p></header>
      <section class="fixtures-block" aria-labelledby="record-heading">
        <div class="block-head">
          <h2 id="record-heading">Record</h2>
        </div>
        <figure class="register-figure" aria-labelledby="record-cap">
          <figcaption id="record-cap" class="table-caption">Table I. Series and games.<a class="note-ref" href="#note-2" aria-label="Note 2">2</a></figcaption>
          <div class="table-scroll">
            <table class="register register--record">
              <thead>
                <tr>
                  <th scope="col">Calls</th>
                  <th scope="col" class="num">Series</th>
                  <th scope="col" class="num">Favourite won</th>
                  <th scope="col" class="num phone-hide">Games</th>
                  <th scope="col" class="num phone-hide">Picked</th>
                  <th scope="col" class="num">Log loss</th>
                </tr>
              </thead>
              <tbody>
                {% for row in view.scorecard %}
                <tr{% if loop.last %} class="record-total"{% endif %}>
                  <th scope="row">{{ row.label }}{% if row.label == 'Reconstructed' %}<a class="note-ref" href="#note-1" aria-label="Note 1">1</a>{% endif %}</th>
                  <td class="num">{{ row.series }}</td>
                  <td class="num value">{% if row.series %}{{ row.series_pct | round(1) }}<span class="of"> %</span>{% else %}<span class="muted">—</span>{% endif %}</td>
                  <td class="num phone-hide">{{ row.games | round | int }}</td>
                  <td class="num phone-hide">{% if row.games %}{{ row.games_pct | round(1) }}<span class="of"> %</span>{% else %}<span class="muted">—</span>{% endif %}</td>
                  <td class="num">{% if row.games %}{{ '%.3f' | format(row.log_loss) }}{% else %}<span class="muted">—</span>{% endif %}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </figure>

        {% set span = view.backtest_span %}
        <figure class="register-figure" aria-labelledby="market-cap">
          <figcaption id="market-cap" class="table-caption">Table II. Against Kalshi’s close, on matches priced 12h out. Negative difference favours us.<a class="note-ref" href="#note-3" aria-label="Note 3">3</a></figcaption>
          <div class="table-scroll">
            <table class="register register--record register--market register--edges">
              <thead>
                <tr>
                  <th scope="col" rowspan="2" class="edges-calls">Calls</th>
                  <th scope="col" rowspan="2"{% if span %} title="Backtest: {{ span[0] | longdate }} – {{ span[1] | longdate }}"{% endif %}>Source</th>
                  <th scope="col" class="num" rowspan="2">Series</th>
                  <th scope="colgroup" colspan="2" class="num phone-hide">Favourite won</th>
                  <th scope="colgroup" colspan="2" class="num">Log loss</th>
                  <th scope="col" class="num" rowspan="2">Difference <span class="ci">(95%)</span></th>
                </tr>
                <tr>
                  <th scope="col" class="num phone-hide">Ours</th>
                  <th scope="col" class="num phone-hide">Kalshi</th>
                  <th scope="col" class="num">Ours</th>
                  <th scope="col" class="num">Kalshi</th>
                </tr>
              </thead>
              {% for group in view.vs_market %}
              <tbody>
                {% for src in group.sources %}
                {% for row in src.rows %}
                <tr{% if src.name == 'backtest' %} class="edges-backtest"{% endif %}>
                  {% if loop.first and src.name == 'saved' %}<th scope="rowgroup" rowspan="{{ group.sources | sum(attribute='rows', start=[]) | length }}" class="edges-calls" title="{{ 'Calls within a major league' if group.label == 'FORGE' else 'All other calls' }}">{{ group.label }}</th>{% endif %}
                  <th scope="row" class="edges-source"><span class="edges-method">{{ group.label }}, </span>{{ 'Backtest' if src.name == 'backtest' else 'Saved' }}</th>
                  <td class="num">{{ row.series }}</td>
                  {% if row.series %}
                  <td class="num phone-hide">{{ row.ours_pct | round | int }}<span class="of"> %</span></td>
                  <td class="num phone-hide">{{ row.market_pct | round | int }}<span class="of"> %</span></td>
                  <td class="num value">{{ '%.3f' | format(row.ours_loss) }}</td>
                  <td class="num">{{ '%.3f' | format(row.market_loss) }}</td>
                  <td class="num">{% if row.diff %}{{ '%+.3f' | format(row.diff[0]) }} <span class="ci">({{ '%+.3f' | format(row.diff[1]) }} to {{ '%+.3f' | format(row.diff[2]) }})</span>{% else %}<span class="muted">too few</span>{% endif %}</td>
                  {% else %}
                  <td class="num phone-hide"><span class="muted">—</span></td>
                  <td class="num phone-hide"><span class="muted">—</span></td>
                  <td class="num"><span class="muted">—</span></td>
                  <td class="num"><span class="muted">—</span></td>
                  <td class="num"><span class="muted">—</span></td>
                  {% endif %}
                </tr>
                {% endfor %}
                {% endfor %}
              </tbody>
              {% endfor %}
            </table>
          </div>
        </figure>
      </section>
  <figure class="register-figure" aria-labelledby="trading-cap"><figcaption id="trading-cap" class="table-caption">Table III. <a href="market-blend.html">Market Blend</a>. Bets require net edge &gt; 0: blended chance minus ask and estimated fees. $1 plus fees per pick; return on total outlay.</figcaption>
  {% with edge_groups = view.trading_edges, show_edge = false %}{% include '_call_edges.html.j2' %}{% endwith %}
  </figure>
  <figure class="register-figure" aria-labelledby="edges-cap"><figcaption id="edges-cap" class="table-caption">Table IV. Raw forecast comparisons. “Any” backs our favourite; other rows back the larger edge. Includes excluded cross-league fixtures.</figcaption>
  {% with edge_groups = view.performance_edges %}{% include '_call_edges.html.j2' %}{% endwith %}
  </figure>
  {% for group in groups %}
  <section class="fixtures-block" aria-labelledby="{{ group.id }}-heading">
    <div class="block-head"><h2 id="{{ group.id }}-heading">{{ group.title }}</h2></div>
    {% if group.rows %}
    <details><summary>Call history</summary>
    <figure class="register-figure"><figcaption class="table-caption">Larger-edge side, newest first. $1 per call; negative edges included.</figcaption>
    <div class="table-scroll" tabindex="0" role="region" aria-label="{{ group.title }} call history"><table class="register register--alerts">
      <thead><tr><th scope="col">Date <span class="muted">UTC</span></th><th scope="col">Pick</th><th scope="col">Source</th><th scope="col" class="num">Chance</th><th scope="col" class="num">Ask</th><th scope="col" class="num">Edge</th><th scope="col">Outcome</th><th scope="col" class="num">Profit</th><th scope="col" class="num">CLV</th></tr></thead>
      <tbody>{% for row in group.rows %}<tr>
        <td class="alert-date"><time datetime="{{ row.start }}">{{ row.start | shortdate }}</time></td>
        <th scope="row" class="alert-pick" title="{{ row.event }}">{{ row.back }}<span class="alert-opponent">v {{ row.other }}</span></th>
        <td>{{ row.source }}</td><td class="num">{{ '%.1f' | format(100 * row.chance) }}%</td><td class="num">{{ '%.1f' | format(100 * row.ask) }}¢</td><td class="num">{{ '%+.1f' | format(100 * row.edge) }}</td>
        <td>{{ 'Won' if row.won else 'Lost' }}</td><td class="num value">{{ '%+.2f' | format(row.profit) | replace('-', '−') }}</td><td class="num">{% if row.clv is not none %}{{ '%+.1f' | format(100 * row.clv) }}{% else %}—{% endif %}</td>
      </tr>{% endfor %}</tbody>
    </table></div></figure></details>
    {% else %}<p class="empty">No priced results yet.</p>{% endif %}
  </section>{% endfor %}
</div><aside class="margin notes"><h2 class="margin-head">The calls</h2><ol class="notes-list"><li id="note-1"><span class="note-mark" aria-hidden="true">1</span>Saved calls precede play. Backtests use earlier ratings, but their weights saw these games.</li><li id="note-2"><span class="note-mark" aria-hidden="true">2</span>Log loss: lower is better; a coin flip scores 0.693. Record uses map odds; market comparison uses series odds.</li><li id="note-3"><span class="note-mark" aria-hidden="true">3</span>Kalshi refreshes hourly; its caret marks the bar. Blend combines Kalshi with FORGE/Elo. CLV: close minus ask, in points. Alerts: 6h+ out. Cloud9 fixtures and bets against NA internationally never trade.</li><li><span class="note-mark" aria-hidden="true">4</span>These are fixed 12-hour observations. Alert history records the first qualifying alert.</li></ol></aside></div>
{% endblock %}
