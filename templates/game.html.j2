{% extends 'base.html.j2' %}
{% from '_marks.html.j2' import fixtures, filter_line %}
{% block title %}{{ view.name }} · Prometheus{% endblock %}
{% block description %}{{ view.name }} series calls and results.{% endblock %}
{% block canonical_path %}other/{{ view.game }}.html{% endblock %}
{% block head_extra %}<link rel="stylesheet" href="{{ root_path }}{{ asset('css/live.css') }}" />{% endblock %}
{% block content %}
  <div class="spread spread--wide">
    <div class="spread-main">
      <header class="section-head">
        <h1>{{ view.name }}</h1>
        <p class="lede">Calls freeze at start. Data through {{ view.data_through }}.</p>
      </header>

      {{ filter_line(view) }}

      {% if view.live %}
      {#- Hidden whenever the filters leave nothing live, as on the LoL page. #}
      <section class="fixtures-block" aria-labelledby="live-heading" data-section-for="live">
        <div class="block-head"><h2 id="live-heading">Live now</h2></div>
        <figure class="register-figure" aria-labelledby="live-cap">
          <figcaption id="live-cap" class="table-caption">Table I. <span class="count" data-count-for="live" aria-live="polite"></span></figcaption>
          <div class="table-scroll">{{ fixtures(view.live, results=True, compact=True, id='live', lg_label='Tier') }}</div>
        </figure>
      </section>
      {% endif %}

      <section id="upcoming-section" class="fixtures-block" aria-labelledby="upcoming-heading">
        <div class="block-head">
          <h2 id="upcoming-heading">Coming up</h2>
        </div>
        <figure class="register-figure" aria-labelledby="upcoming-cap">
          <figcaption id="upcoming-cap" class="table-caption">Table II. <span class="count" data-count-for="upcoming" aria-live="polite">{{ view.upcoming_count }} matches.</span></figcaption>
          {% if view.upcoming %}
          <div class="table-scroll">{{ fixtures(view.upcoming, id='upcoming', lg_label='Tier', blend=False) }}</div>
          {% endif %}
          <p class="empty fx-empty" data-empty-for="upcoming"{% if view.upcoming %} hidden{% endif %}>{% if view.upcoming %}No matching fixtures.{% else %}No rated matches this week.{% endif %}</p>
        </figure>
      </section>

      <section class="fixtures-block" aria-labelledby="past-heading">
        <div class="block-head">
          <h2 id="past-heading">Results</h2>
          <a class="more" href="{{ view.game }}.json">Download calls</a>
        </div>
        <figure class="register-figure register-figure--main" aria-labelledby="past-cap">
          <figcaption id="past-cap" class="table-caption">Table III. Last {{ view.recent_days }} days. <span class="count" data-count-for="past" aria-live="polite"></span></figcaption>
          {% if view.past %}
          <div class="table-scroll">{{ fixtures(view.past, results=True, compact=True, id='past', lg_label='Tier') }}</div>
          {% endif %}
          <p class="empty fx-empty" data-empty-for="past"{% if view.past %} hidden{% endif %}>{% if view.past %}No matching results.{% else %}No recent results.{% endif %}</p>
        </figure>
        {% if view.months %}
        <p class="month-index"><span class="month-index-lead">By month</span> {% for m in view.months %}<a href="{{ view.game }}/{{ m.key }}.html">{{ m.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
        {% endif %}
      </section>
    </div>

    <aside class="margin notes" id="about" aria-labelledby="about-heading">
      <h2 id="about-heading" class="margin-head">Reading the odds</h2>
      <ol class="notes-list">
        <li id="note-1"><span class="note-mark" aria-hidden="true">1</span>Figures: each team's series chance in 100. Game: one map's chance.</li>
        <li id="note-2"><span class="note-mark" aria-hidden="true">2</span>{{ view.model }}. Source: <a href="{{ view.source.url }}">{{ view.source.name }}</a>{% if view.source.license %} ({{ view.source.license }}){% endif %}.</li>
        <li id="note-3"><span class="note-mark" aria-hidden="true">3</span>Marked calls were rebuilt after the match from the ratings before it.</li>
        <li id="note-4"><span class="note-mark" aria-hidden="true">4</span>Kalshi: current mid price for upcoming matches. Close: last hourly price before the start.</li>
      </ol>
    </aside>
  </div>
{% endblock %}
{% block scripts %}
  <script src="{{ root_path }}{{ asset('js/predictions.js') }}" defer></script>
{% endblock %}
